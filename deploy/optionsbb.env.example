# Copiar a /etc/optionsbb.env  (sudo nano /etc/optionsbb.env)  y chmod 600
OBB_HOST=127.0.0.1
OBB_PORT=8080
OBB_PUBLIC_URL=https://app.optionsbb.com
OBB_COOKIE_SECURE=1
OBB_TRUST_PROXY=1
OBB_ADMIN_EMAIL=infoptionsbb@gmail.com
OBB_DATA=/var/lib/optionsbb
OBB_DEMO=1
# Opcional (cuando los tengas):
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=
# LOGO_URL=
